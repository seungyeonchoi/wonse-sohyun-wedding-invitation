# 배포 도메인 (OG 이미지·카카오 공유 링크의 절대경로)
NEXT_PUBLIC_SITE_URL=https://example.com

# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# (플랫폼 > Web 에 배포 도메인과 http://localhost:3000 등록 필요)
# 없으면 지도는 OpenStreetMap, 공유는 OS 공유 시트/주소 복사로 대체됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase (방명록·좋아요·하트·타임캡슐). 서버에서만 쓰므로 NEXT_PUBLIC_ 을 붙이지 않습니다.
# 스키마: supabase/migrations/*_wedding_invitation.sql
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
